# ---------------------------------------------------------------------------
# Copy this file to .env and fill in real values. NEVER commit .env
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="Hanadi Store"
# Set to true only when the public storefront should return a maintenance page.
PUBLIC_SITE_MAINTENANCE=false
# 32+ random bytes, e.g. `openssl rand -base64 48`
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Trusted edge header; the reverse proxy must overwrite it on every request.
TRUSTED_CLIENT_IP_HEADER=x-real-ip

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hanadi_store?schema=public
# Optional direct PostgreSQL connection for online index creation when DATABASE_URL uses a transaction pooler
DIRECT_URL=

# --- Storage (S3-compatible: AWS S3, Cloudflare R2, MinIO, Backblaze...) ----
# Leave empty to use local disk storage in development (public/uploads)
STORAGE_DRIVER=local            # local | s3
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=               # e.g. https://<account>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_HOST=            # hostname(s) serving the bucket public URLs, comma separated
STORAGE_FORCE_PATH_STYLE=false

# --- Copy protection (optional) --------------------------------------------------
# Point at a PNG with transparency (e.g. the white wordmark, ~600px wide,
# baked at 60-80% opacity) to stamp every uploaded product photo
# bottom-right at 18% of the photo width. Unset = original pipeline,
# byte-identical uploads. Set-but-unreadable = uploads fail closed.
# PRODUCT_WATERMARK_PATH=

# --- Shared rate limiting (optional; PostgreSQL fallback is always shared) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Notifications (all optional; without config events are logged only) ----
EMAIL_PROVIDER=                 # resend | console
EMAIL_API_KEY=
EMAIL_FROM="Hanadi Store <orders@example.com>"

SMS_PROVIDER=                   # twilio | console
SMS_API_KEY=
SMS_ACCOUNT_SID=
SMS_FROM=

WHATSAPP_PROVIDER=              # meta|console
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
# Optional approved Meta template. Use a French template with one body variable {{1}}
# for business-initiated order confirmations outside the 24-hour WhatsApp window.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=fr

# --- Analytics (never hard-coded; empty disables loading) -------------------
META_PIXEL_ID=
META_CONVERSIONS_API_KEY=
ORDER_OUTBOX_SECRET=             # 32+ random bytes; authorizes the production outbox retry endpoint
RETENTION_JOB_SECRET=            # 32+ random bytes; authorizes scheduled technical-data cleanup
RETENTION_ANALYTICS_DAYS=90
RETENTION_NOTIFICATION_DAYS=180
RETENTION_OUTBOX_DAYS=30
# Optional checkout transaction budget in ms (default 5000, clamped 5000-60000).
# Raise only when the database is far from the app server (e.g. local dev
# against a remote DB); production co-located with its DB must not need this.
# CHECKOUT_TX_TIMEOUT_MS=20000

# --- Seed / demo admin (development only) -----------------------------------
SEED_ADMIN_EMAIL=admin@example.com
# Required for `prisma db seed`; set a unique 10+ character mixed-case password.
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Store Admin
