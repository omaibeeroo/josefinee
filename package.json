{
  "name": "josefinee-store",
  "version": "0.1.0",
  "private": true,
  "description": "Premium fashion & jewelry e-commerce for Algeria (COD) — Hanadi Store",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "node scripts/apply-braces-depth-guard.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:production": "./scripts/smoke-production.sh",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/create-fk-indexes-concurrently.mjs && prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@node-rs/argon2": "2.2.1",
    "@prisma/client": "6.19.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "next": "15.5.27",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "15.5.27",
    "prettier": "^3.4.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.3",
    "braces": "file:vendor/braces"
  },
  "overrides": {
    "postcss": "8.5.28",
    "deepmerge-ts": "8.0.2",
    "braces": "file:vendor/braces"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "sharp@0.35.5": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
